              ]
            },
            {
              "condition": "[and(and(parameters('daprEnabled'), not(empty(parameters('redisHostName')))), not(empty(parameters('redisPrimaryKey'))))]",
              "type": "Microsoft.App/managedEnvironments/daprComponents",
