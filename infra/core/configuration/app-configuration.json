  "outputs": {
    "appConfigEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Endpoint URL for App Configuration"
      },
      "value": "[reference('appConfig').endpoint]"
    },
    "appConfigName": {
      "type": "string",
      "metadata": {
        "description": "Name of App Configuration resource"
      },
      "value": "[parameters('appConfigName')]"
    },
    "appConfigResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of App Configuration"
      },
      "value": "[resourceId('Microsoft.AppConfiguration/configurationStores', parameters('appConfigName'))]"
    },
    "appConfigPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Managed identity principal ID for RBAC"
      },
      "value": "[reference('appConfig', '2023-03-01', 'full').identity.principalId]"
    },
    "appConfigConnectionString": {
      "type": "securestring",
      "metadata": {
        "description": "Connection string for App Configuration - marked as secure"
      },
      "value": "[listKeys('appConfig', '2023-03-01').value[0].connectionString]"
    }
  }
}