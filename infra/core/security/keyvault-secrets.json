      "properties": {
        "value": "[format('Server={0};Database={1};User Id=sqladmin;Password={2};TrustServerCertificate=True;', parameters('sqlFqdn'), parameters('authDbName'), parameters('sqlAdminPassword'))]"
      },
      "dependsOn": [
