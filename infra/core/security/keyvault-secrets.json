      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.KeyVault/vaults/{0}', parameters('name'))]",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('name')), parameters('userAssignedIdentityPrincipalId'), subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('azureRoleIdKeyVaultSecretsUser')))]",
      "properties": {
