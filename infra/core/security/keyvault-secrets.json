      "name": "[format('{0}/{1}', parameters('name'), 'sql-connection-salesdb')]",
      "properties": {
        "value": "[format('Server={0};Database={1};User Id=sqladmin;Password={2};TrustServerCertificate=True;', parameters('sqlFqdn'), parameters('salesDbName'), parameters('sqlAdminPassword'))]"
