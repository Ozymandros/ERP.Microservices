      "properties": {
        "value": "[format('{0}:6380,password={1},ssl=True,abortConnect=False', parameters('redisHostName'), parameters('redisPrimaryKey'))]"
      },
      "dependsOn": [
        "keyVault"
      ]
    },
    "kvRedisCachePasswordSecret": {
      "condition": "[not(empty(parameters('redisCachePassword')))]",
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', parameters('name'), 'redis-cache-password')]",
