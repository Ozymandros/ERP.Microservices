      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2022-07-01",
      "name": "[format('{0}/{1}', parameters('name'), 'sql-connection-ordersdb')]",
      "properties": {
        "value": "[format('Server={0};Database={1};User Id=sqladmin;Password={2};TrustServerCertificate=True;', parameters('sqlFqdn'), parameters('ordersDbName'), parameters('sqlAdminPassword'))]"
