project                  = "myapp"
environment              = "dev"
region                   = "eu-madrid-1"

# OCI local authentication (Phase 1 local-first).
tenancy_ocid             = "ocid1.tenancy.oc1..replace_me"
user_ocid                = "ocid1.user.oc1..replace_me"
fingerprint              = "aa:bb:cc:dd:ee:ff:11:22:33:44:55:66:77:88:99:00"
private_key_path         = "~/.oci/oci_api_key.pem"

# Optional: keep empty to create a dedicated compartment.
existing_compartment_ocid = ""
compartment_name          = "cmp-myapp-dev-core"

vcn_cidr           = "10.60.0.0/16"
public_subnet_cidr = "10.60.1.0/24"
private_subnet_cidr = "10.60.2.0/24"

kubernetes_version = "v1.30.1"
node_pool_size     = 2
node_shape         = "VM.Standard.A1.Flex"
node_ocpus         = 2
node_memory_gbs    = 12
image_id           = ""

freeform_tags = {
  owner      = "platform"
  cost-center = "erp"
}
