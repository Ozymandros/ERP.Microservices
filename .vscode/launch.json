{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (Aspire)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/AppHost/AppHost.csproj",
        "--launch-profile",
        "https"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "preLaunchTask": "kill-stale-apphost",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      },
      "internalConsoleOptions": "neverOpen",
      "stopAtEntry": false
    },
    {
      "type": "aspire",
      "request": "launch",
      "name": "Aspire: Launch",
      "program": "${workspaceFolder}/src/AppHost/AppHost.csproj",
      "debuggers": {
        "apphost": {
          "launchProfile": "https",
          "env": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DOTNET_ENVIRONMENT": "Development"
          }
        }
      }
    }
  ]
}
