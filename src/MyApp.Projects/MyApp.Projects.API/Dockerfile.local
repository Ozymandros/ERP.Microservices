# Local / docker-compose build (build context: ./src)

# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy nuget.config to ensure clean package resolution (build context is ./src)
COPY nuget.config ./

# Copy shared projects (build context is ./src)
COPY ["MyApp.Shared/MyApp.Shared.Domain/MyApp.Shared.Domain.csproj", "MyApp.Shared/MyApp.Shared.Domain/"]
COPY ["MyApp.Shared/MyApp.Shared.Application/MyApp.Shared.Application.csproj", "MyApp.Shared/MyApp.Shared.Application/"]
COPY ["MyApp.Shared/MyApp.Shared.Infrastructure/MyApp.Shared.Infrastructure.csproj", "MyApp.Shared/MyApp.Shared.Infrastructure/"]
COPY ["MyApp.Shared/MyApp.Shared.CQRS/MyApp.Shared.CQRS.csproj", "MyApp.Shared/MyApp.Shared.CQRS/"]
COPY ["MyApp.Shared/MyApp.Shared.SignalR/MyApp.Shared.SignalR.csproj", "MyApp.Shared/MyApp.Shared.SignalR/"]

# Copy Projects service projects
COPY ["MyApp.Projects/MyApp.Projects.Domain/MyApp.Projects.Domain.csproj", "MyApp.Projects/MyApp.Projects.Domain/"]
COPY ["MyApp.Projects/MyApp.Projects.Application.Contracts/MyApp.Projects.Application.Contracts.csproj", "MyApp.Projects/MyApp.Projects.Application.Contracts/"]
COPY ["MyApp.Projects/MyApp.Projects.Application/MyApp.Projects.Application.csproj", "MyApp.Projects/MyApp.Projects.Application/"]
COPY ["MyApp.Projects/MyApp.Projects.Infrastructure/MyApp.Projects.Infrastructure.csproj", "MyApp.Projects/MyApp.Projects.Infrastructure/"]
COPY ["MyApp.Projects/MyApp.Projects.API/MyApp.Projects.API.csproj", "MyApp.Projects/MyApp.Projects.API/"]

# Cross-service Application.Contracts (compile-time DTO references only)
COPY ["MyApp.Sales/MyApp.Sales.Domain/MyApp.Sales.Domain.csproj", "MyApp.Sales/MyApp.Sales.Domain/"]
COPY ["MyApp.Sales/MyApp.Sales.Application.Contracts/MyApp.Sales.Application.Contracts.csproj", "MyApp.Sales/MyApp.Sales.Application.Contracts/"]
COPY ["MyApp.Inventory/MyApp.Inventory.Domain/MyApp.Inventory.Domain.csproj", "MyApp.Inventory/MyApp.Inventory.Domain/"]
COPY ["MyApp.Inventory/MyApp.Inventory.Application.Contracts/MyApp.Inventory.Application.Contracts.csproj", "MyApp.Inventory/MyApp.Inventory.Application.Contracts/"]
COPY ["MyApp.Orders/MyApp.Orders.Domain/MyApp.Orders.Domain.csproj", "MyApp.Orders/MyApp.Orders.Domain/"]
COPY ["MyApp.Orders/MyApp.Orders.Application.Contracts/MyApp.Orders.Application.Contracts.csproj", "MyApp.Orders/MyApp.Orders.Application.Contracts/"]

# Restore dependencies
RUN dotnet restore "MyApp.Projects/MyApp.Projects.API/MyApp.Projects.API.csproj"

# Copy only needed source files (not everything from context)
COPY MyApp.Shared/ MyApp.Shared/
COPY MyApp.Sales/MyApp.Sales.Domain/ MyApp.Sales/MyApp.Sales.Domain/
COPY MyApp.Sales/MyApp.Sales.Application.Contracts/ MyApp.Sales/MyApp.Sales.Application.Contracts/
COPY MyApp.Inventory/MyApp.Inventory.Domain/ MyApp.Inventory/MyApp.Inventory.Domain/
COPY MyApp.Inventory/MyApp.Inventory.Application.Contracts/ MyApp.Inventory/MyApp.Inventory.Application.Contracts/
COPY MyApp.Orders/MyApp.Orders.Domain/ MyApp.Orders/MyApp.Orders.Domain/
COPY MyApp.Orders/MyApp.Orders.Application.Contracts/ MyApp.Orders/MyApp.Orders.Application.Contracts/
COPY MyApp.Projects/ MyApp.Projects/

# Build the project
WORKDIR "/src/MyApp.Projects/MyApp.Projects.API"
RUN dotnet build "MyApp.Projects.API.csproj" -c Release -o /app/build --no-restore

# Publish stage
FROM build AS publish
RUN dotnet publish "MyApp.Projects.API.csproj" -c Release -o /app/publish /p:UseAppHost=false --no-restore

# Runtime stage - Use shared base image
FROM myapp-microservices-base:10.0 AS final
USER appuser
WORKDIR /app
COPY --chown=appuser:appuser --from=publish /app/publish .
ENTRYPOINT ["dotnet", "MyApp.Projects.API.dll"]
