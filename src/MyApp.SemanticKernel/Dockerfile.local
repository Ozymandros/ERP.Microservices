# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy nuget.config to ensure clean package resolution (build context is ./src)
COPY nuget.config ./

# Copy referenced project files (only csproj files) so restore can resolve project refs
COPY ["MyApp.Shared/MyApp.Shared.Domain/MyApp.Shared.Domain.csproj", "MyApp.Shared/MyApp.Shared.Domain/"]
COPY ["MyApp.Shared/MyApp.Shared.Infrastructure/MyApp.Shared.Infrastructure.csproj", "MyApp.Shared.MyApp.Shared.Infrastructure/"]
COPY ["MyApp.Shared/MyApp.Shared.CQRS/MyApp.Shared.CQRS.csproj", "MyApp.Shared.MyApp.Shared.CQRS/"]
COPY ["MyApp.Shared/MyApp.Shared.SignalR/MyApp.Shared.SignalR.csproj", "MyApp.Shared.MyApp.Shared.SignalR/"]

COPY ["MyApp.Auth/MyApp.Auth.Application.Contracts/MyApp.Auth.Application.Contracts.csproj", "MyApp.Auth.MyApp.Auth.Application.Contracts/"]
COPY ["MyApp.Billing/MyApp.Billing.Application.Contracts/MyApp.Billing.Application.Contracts.csproj", "MyApp.Billing.MyApp.Billing.Application.Contracts/"]
COPY ["MyApp.Crm/MyApp.Crm.Application.Contracts/MyApp.Crm.Application.Contracts.csproj", "MyApp.Crm.MyApp.Crm.Application.Contracts/"]
COPY ["MyApp.Inventory/MyApp.Inventory.Application.Contracts/MyApp.Inventory.Application.Contracts.csproj", "MyApp.Inventory.MyApp.Inventory.Application.Contracts/"]
COPY ["MyApp.Orders/MyApp.Orders.Application.Contracts/MyApp.Orders.Application.Contracts.csproj", "MyApp.Orders.MyApp.Orders.Application.Contracts/"]
COPY ["MyApp.Purchasing/MyApp.Purchasing.Application.Contracts/MyApp.Purchasing.Application.Contracts.csproj", "MyApp.Purchasing.MyApp.Purchasing.Application.Contracts/"]
COPY ["MyApp.Sales/MyApp.Sales.Application.Contracts/MyApp.Sales.Application.Contracts.csproj", "MyApp.Sales.MyApp.Sales.Application.Contracts/"]

COPY ["MyApp.SemanticKernel/MyApp.SemanticKernel.csproj", "MyApp.SemanticKernel/"]

# Restore dependencies with BuildKit cache mount
RUN --mount=type=cache,id=nuget-shared,target=/root/.nuget/packages \
    dotnet restore "MyApp.SemanticKernel/MyApp.SemanticKernel.csproj"

# Copy source files
COPY MyApp.Shared/ MyApp.Shared/
COPY MyApp.Auth/ MyApp.Auth/
COPY MyApp.Billing/ MyApp.Billing/
COPY MyApp.Crm/ MyApp.Crm/
COPY MyApp.Inventory/ MyApp.Inventory/
COPY MyApp.Orders/ MyApp.Orders/
COPY MyApp.Purchasing/ MyApp.Purchasing/
COPY MyApp.Sales/ MyApp.Sales/
COPY MyApp.SemanticKernel/ MyApp.SemanticKernel/

# Build the project
WORKDIR "/src/MyApp.SemanticKernel"
RUN --mount=type=cache,id=nuget-shared,target=/root/.nuget/packages \
    dotnet build "MyApp.SemanticKernel.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN --mount=type=cache,id=nuget-shared,target=/root/.nuget/packages \
    dotnet publish "MyApp.SemanticKernel.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage - Use shared base image
FROM myapp-microservices-base:10.0 AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "MyApp.SemanticKernel.dll"]
