<Project>
  <PropertyGroup>
    <_IsPureLibraryProject Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Domain')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.Application.Contracts')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.CQRS')) Or $([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.SignalR'))">true</_IsPureLibraryProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(_IsPureLibraryProject)' != 'true'">
    <!-- Pin patched transitive dependency (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
