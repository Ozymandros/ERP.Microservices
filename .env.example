# ============================================================================
# ERP Microservices - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and update values for your local environment
# ============================================================================

# SQL Server
SQL_PASSWORD=P@ssw0rd12345!

# Redis
REDIS_PASSWORD=Redis@Secure123!

# JWT Configuration
JWT_SECRET=una_clau_molt_llarga_i_super_ultra_secreta_01234566789
JWT_ISSUER=MyApp.Auth
JWT_AUDIENCE=MyApp.All

# Frontend Origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000;http://localhost:5000

# DAPR (automatic, but can be overridden if needed)
# DAPR_HTTP_PORT=3500
# DAPR_GRPC_PORT=50001

# ============================================================================
# Docker Compose Services Configuration
# ============================================================================

# Service Ports (already exposed in docker-compose, but can be changed)
# NOTE: Registration order in AppHost/Program.cs is A,B,C,I,O,P,S,K
#       (Auth, Billing, CRM, Inventory, Orders, Purchasing, Sales, SemanticKernel)
#       AspireProjectBuilder assigns http ports sequentially from 6000 (first increment -> 6001).
#
# Gateway HTTP Port:       5000
# Gateway HTTPS Port:      7231
# Auth Service Port:       6001
# Billing Service Port:    6002
# CRM Service Port:        6003
# Inventory Service Port:  6004
# Orders Service Port:     6005
# Purchasing Service Port: 6006
# Sales Service Port:      6007
# SemanticKernel Port:     6008

# Redis Tools
# Redis Commander: 8081
# Redis Insight: 5540

# ============================================================================
# Production Overrides (when deploying to production)
# ============================================================================
# Uncomment and update these for production deployments

# ENVIRONMENT=Production
# SQL_PASSWORD=<your-secure-sql-password>
# REDIS_PASSWORD=<your-secure-redis-password>
# JWT_SECRET=<your-production-jwt-secret>
# FRONTEND_ORIGIN=https://app.yourdomain.com;https://www.yourdomain.com
